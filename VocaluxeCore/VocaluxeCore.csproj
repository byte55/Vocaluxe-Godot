<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Nullable disabled: this library is a faithful port of legacy VocaluxeLib code
         written without nullable annotations. New (game) code keeps nullable enabled. -->
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy CP1250/CP1252 support for UltraStar files (not built into modern .NET) -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
